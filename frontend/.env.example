# Backend API base URL.
# - Local web dev: leave unset — the Vite proxy forwards /api to localhost:8000
# - Production web / native app builds: set to your deployed backend root
#   (no trailing /api), e.g. https://api.myginnie.life
VITE_API_BASE_URL=

# Social login client IDs (optional — buttons no-op until set)
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
